  "releases": [
    {"version":"1.1.0-rc.4","download":"https://github.com/DeKaeyman/ChunkVeil/releases/tag/v1.1.0-rc.4","severity":"recommended","prerelease":true,"mc":[{"min":"1.21","max":"1.21"},{"min":"26.0","max":"26.2"}],"notes":"A running server is never taken down by a single bad packet anymore: rare runtime packet failures (usually from another packet-rewriting plugin) drop only that packet, re-request the chunk, and keep protection active; quarantine now requires repeated failures. Adds real diagnostics and evidence-based conflict naming to failure logs. Strongly recommended for all 1.1.0 release-candidate testers."},
    {"version":"1.1.0-rc.3","download":"https://github.com/DeKaeyman/ChunkVeil/releases/tag/v1.1.0-rc.3","severity":"optional","prerelease":true,"mc":[{"min":"1.21","max":"1.21"},{"min":"26.0","max":"26.2"}],"notes":"Stops thread-check log spam and TPS stutter on Folia-family servers when other plugins (TAB, holograms) flush packets from their own threads: the entity-spawn handler no longer resolves live entities there and works purely from packet data. Strongly recommended for all Folia testers."},
    {"version":"1.1.0-rc.2","download":"https://github.com/DeKaeyman/ChunkVeil/releases/tag/v1.1.0-rc.2","severity":"optional","prerelease":true,"mc":[{"min":"1.21","max":"1.21"},{"min":"26.0","max":"26.2"}],"notes":"Fixes a Folia-family security trip when another plugin flushes queued spawn packets from a foreign thread (reported on Canvas 26.2). Detects an incompatible ProtocolLib build at startup and names it clearly in the log instead of protection failing on the first player join. Adds Folia 26.1.2 to the boot-verified targets. Strongly recommended for all Folia testers."},
    {"version":"1.1.0-rc.1","download":"https://github.com/DeKaeyman/ChunkVeil/releases/tag/v1.1.0-rc.1","severity":"optional","prerelease":true,"mc":[{"min":"1.21","max":"1.21"},{"min":"26.0","max":"26.2"}],"notes":"Release candidate adding experimental Folia support in the same universal jar. All scheduling now uses Paper's modern scheduler APIs with one engine worker per player; Paper behavior is unchanged. Folia targets are boot-verified; test before production use."},
    {"version":"1.0.2","download":"https://github.com/DeKaeyman/ChunkVeil/releases/tag/v1.0.2","severity":"recommended","prerelease":false,"mc":[{"min":"1.21","max":"1.21"},{"min":"26.0","max":"26.2"}],"notes":"Fixes cross-player packet corruption where blocks placed or mined by an underground player turned into the fake block and desynced into ghost blocks when another player was nearby. Strongly recommended for all servers."},
    {"version":"1.0.1","download":"https://github.com/DeKaeyman/ChunkVeil/releases/tag/v1.0.1","severity":"recommended","prerelease":false,"mc":[{"min":"1.21","max":"1.21"},{"min":"26.0","max":"26.2"}],"notes":"Fixes explosion packet inspection on Minecraft 1.21.2+, where any explosion tripped the security quarantine with cancel-explosions enabled. Strongly recommended for all servers."},
    {"version":"1.0.0","download":"https://github.com/DeKaeyman/ChunkVeil/releases/tag/v1.0.0","severity":"recommended","prerelease":false,"mc":[{"min":"1.21","max":"1.21"},{"min":"26.0","max":"26.2"}],"notes":"Stable confidentiality-first release with particle, vibration-origin and light protection, diagnostics, compatibility verification, and additive config upgrades."},
    {"version":"1.0.0-rc.1","download":"https://github.com/DeKaeyman/ChunkVeil/releases/tag/v1.0.0-rc.1","severity":"recommended","prerelease":true,"mc":[{"min":"1.21","max":"1.21"},{"min":"26.0","max":"26.2"}],"notes":"Release candidate with confidentiality-first packet handling, particle/vibration/light protection, diagnostics, compatibility verification, and additive config upgrades."},
